ANTHROPIC_API_KEY=

# Which NarratorBackend to use (see server/narrator.py): "anthropic" (hosted
# Claude, needs ANTHROPIC_API_KEY) or "ollama" (local, free, needs `pip install
# -e ".[ollama]"` and a running Ollama server with a model pulled).
DM_BACKEND=anthropic

# Only used when DM_BACKEND=ollama. OLLAMA_HOST defaults to localhost:11434 if
# unset. qwen2.5:7b is the default because it tested more reliable at actually
# calling update_character (vs. narrating a fake tool call as text) than
# llama3.1:8b did in live testing — see ROADMAP.md.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=

# Which saved session to resume/create on server startup, and where session
# JSON files are written (see server/persistence.py). Defaults shown below.
SESSION_ID=default
SESSION_STORE_DIR=sessions
