ANTHROPIC_API_KEY=

# Which NarratorBackend to use (see server/narrator.py). Only "anthropic" exists
# today; a local-model backend (e.g. Ollama) can be added later behind the same
# interface without touching the engine or transport layers.
DM_BACKEND=anthropic

# Which saved session to resume/create on server startup, and where session
# JSON files are written (see server/persistence.py). Defaults shown below.
SESSION_ID=default
SESSION_STORE_DIR=sessions
