ANTHROPIC_API_KEY=

# Which NarratorBackend to use (see server/narrator.py): "anthropic" (hosted
# Claude, needs ANTHROPIC_API_KEY) or "ollama" (local, free, needs `pip install
# -e ".[ollama]"` and a running Ollama server with a model pulled).
DM_BACKEND=anthropic

# Only used when DM_BACKEND=ollama. OLLAMA_HOST defaults to localhost:11434 if
# unset. qwen2.5:7b is the default because it tested more reliable at actually
# calling update_character (vs. narrating a fake tool call as text) than
# llama3.1:8b did in live testing — see ROADMAP.md.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=

# Constrained JSON output instead of native tool-calling for the mechanical
# update_character decision - defaults on (unset or anything other than
# "0"/"false"/"no"). A live 5-repeat qwen2.5:7b comparison found this
# roughly doubles real tool-call correctness (66% vs 29% pooled) over
# native tool-calling - see ROADMAP.md item 6. Set to "0" to fall back to
# the legacy tool-calling path (e.g. if you need rest/notes/disposition/
# cast_spell, which structured mode doesn't cover yet).
OLLAMA_STRUCTURED_OUTPUT=

# Experimental, off by default (unset or anything other than "1"/"true"/
# "yes"): lets the local model request a real dice roll (skill check,
# attack, save) before narrating an uncertain action, same as the hosted
# Claude backend already can. Only takes effect when
# OLLAMA_STRUCTURED_OUTPUT is also on. Real signal so far but real
# inconsistency too (only spot-checked, not yet a full --repeat study) -
# see ROADMAP.md for the actual numbers before turning this on.
OLLAMA_ROLL_REQUESTS=

# Experimental, off by default (unset or anything other than "1"/"true"/
# "yes"): lets the local model track campaign continuity - current
# location, new/completed objectives, newly-discovered places for the Map
# tab - the same as the hosted Claude backend already can via
# update_world. Independent of OLLAMA_ROLL_REQUESTS (either works without
# the other). Live spot-checks found this weaker than OLLAMA_ROLL_REQUESTS
# above - reliable on a session's first scene-establishing turn, but
# mostly silent on real changes for the rest of the same conversation
# (only 4/12 caught across three test runs) - see ROADMAP.md before
# turning this on.
OLLAMA_WORLD_UPDATES=

# Where session JSON files are written/read (see server/persistence.py).
# Which session a game actually loads is chosen per-connection by each
# client's own Session ID field (blank = "default"), not by a server-side
# setting - one server process can now host any number of concurrent games.
SESSION_STORE_DIR=sessions

# Networking (server/main.py, client/main.py). Defaults keep everything on
# localhost, matching the original single-machine behavior. To let other
# machines on your LAN connect: on the machine running `python -m
# server.main`, set SERVER_HOST=0.0.0.0 (listen on every interface) and
# note that machine's LAN IP; on each client machine, set SERVER_URI to
# ws://<that LAN IP>:8765 instead of localhost. SERVER_PORT only needs to
# change if 8765 is already taken.
SERVER_HOST=localhost
SERVER_PORT=8765
SERVER_URI=ws://localhost:8765

# ── Protocol v2 / rebuild additions (docs/REBUILD_PLAN.md) ──────────────
# World-context lorebook directory (context_manifest/context_select).
# WORLD_CONTEXT_DIR=world_context
# Two-phase decide→narrate turns on the Ollama backend ("0" = single-call path).
# OLLAMA_TWO_PHASE=true
# Durable fact ledger on the Ollama two-phase decide call: at most 3 short
# facts per turn (promises, debts, discoveries) stored on the session and
# injected into later turns' context. Off by default - a --repeat 3 harness
# re-run found the added decide-schema field degrades qwen2.5:7b's update_character
# correctness (33% vs 63% pooled); set to "1" to opt in. See ROADMAP.md item 36.
# OLLAMA_FACT_LEDGER=

# ── OpenAI-compatible provider (DM_BACKEND=openai) ──────────────────────
# Works with OpenAI, Deepseek, Kimi, Grok, or any /chat/completions endpoint.
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-chat
